syntax "Markdown" "\.(md|mkd|mkdn|markdown|mdx|mdown)$"

# Tables (Github extension)
color cyan ".*[ :]\|[ :].*"

# headlines
color bold,white,blue "^#{1,6} .*"
color bold,white,sea "^#{2,6} .*"
color bold,white,cyan "^#{3,6} .*"
color bold,sea "^#{4,6} .*"
color bold,cyan "^#{5,6} .*"
color bold,blue "^#{6,6} .*"

# quotes
color pink  start="^>" end="^$"
color pink  "^>.*"

# Emphasis
color italic,green "(^|[[:space:]])(_[^ ][^_]*_|\*[^ ][^*]*\*)"

# Strong emphasis
color bold,lime "(^|[[:space:]])(__[^ ][^_]*__|\*\*[^ ][^*]*\*\*)"

# strike-through
color red "(^|[[:space:]])~~[^ ][^~]*~~"

# horizontal rules
color slate "^(---+|===+|___+|\*\*\*+)\s*$"

# lists
color magenta "^[[:space:]]*[\*+-] |^[[:space:]]*[0-9]+\. "

# leading whitespace
color gray "^[[:space:]]+"

# misc
color white "\(([CcRr]|[Tt][Mm])\)" "\.{3}" "(^|[[:space:]])\-\-($|[[:space:]])"

# links
color red "\[[^]]+\]"
color cyan "\[([^][]|\[[^]]*\])*\]\([^)]+\)"

# images
color magenta "!\[[^][]*\](\([^)]+\)|\[[^]]+\])"

# urls
color brightyellow "https?://[^ )>]+"

# code
color pink   "`[^`]*`|^ {4}[^-+*].*"
# code blocks
color pink start="^```[^$]" end="^```$"
color pink "^```$"

## Trailing spaces
color ,green "[[:space:]]+$"
